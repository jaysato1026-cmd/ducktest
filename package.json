{
  "name": "duck-load-console",
  "version": "1.15.1",
  "private": true,
  "description": "鴨鴨測：Windows 網路診斷、可用性監控與負載測試桌面工具",
  "author": "王宥傑",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build:web": "vite build --configLoader runner",
    "build": "npm run build:web && electron-builder --win nsis portable",
    "build:offline": "npm run build:web && node ./node_modules/electron-builder/out/cli/cli.js --win nsis portable --config.electronDist=vendor/electron39-stable --config.asar=false --config.win.signAndEditExecutable=false",
    "test": "node --test src/*.test.mjs electron/*.test.cjs",
    "cli": "node electron/cli.cjs",
    "ci": "node electron/cli.cjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^7.2.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^39.2.0",
    "electron-builder": "^26.0.12",
    "wait-on": "^9.0.1"
  },
  "build": {
    "appId": "tw.wangyoujie.ducktest",
    "productName": "鴨鴨測",
    "directories": {
      "output": "release-v1.15.1"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/icon.ico",
      "assets/icon.png",
      "package.json"
    ],
    "asar": false,
    "win": {
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "${productName}-安裝版-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "鴨鴨測"
    },
    "portable": {
      "artifactName": "${productName}-免安裝版-${version}-${arch}.${ext}"
    }
  }
}
